<Project>
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Location of the BizHawk install whose assemblies external tools compile against.
         Override on the command line with -p:BizHawkHome=... if your install lives elsewhere. -->
    <BizHawkHome Condition="'$(BizHawkHome)' == ''">X:\Games\Emulators\BizHawk - Most Consoles</BizHawkHome>
  </PropertyGroup>
</Project>
