<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BizHawkNetplay.Tool</RootNamespace>
    <AssemblyName>BizHawkNetplay.Tool</AssemblyName>
    <!-- We reference EmuHawk's assemblies but never ship copies of them. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Stamped into the DLL and printed at the top of every log file. A log from someone else is
         unreadable without knowing which build made it, and "which version are you on?" is a
         question people answer wrongly. BUMP THIS WHEN CUTTING A RELEASE — a version that lies is
         worse than none, so it is deliberately the same number as the git tag. -->
    <Version>0.29.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BizHawkNetplay.Core\BizHawkNetplay.Core.csproj" />
  </ItemGroup>

  <!-- BizHawk assemblies to compile against, resolved from the local install.
       Never copied to output: EmuHawk loads the tool from its own ExternalTools dir
       where these already live.

       Only what is actually compiled against. BizHawk.WinForms.Controls and
       BizHawk.Bizware.Graphics were listed here and named by nothing — no using, no type, and no
       member signature that needed them; each was removed and the Tool still built. They are of
       course still loaded by EmuHawk itself, which is why nothing at runtime notices.
       BizHawk.Common was removed on the same evidence and came back with a real caller: the
       checksum's BulkPeekByte path needs Range&lt;long&gt;, which lives there. -->
  <ItemGroup>
    <Reference Include="BizHawk.Common">
      <HintPath>$(BizHawkHome)\dll\BizHawk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Client.Common">
      <HintPath>$(BizHawkHome)\dll\BizHawk.Client.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Emulation.Common">
      <HintPath>$(BizHawkHome)\dll\BizHawk.Emulation.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Client.EmuHawk">
      <HintPath>$(BizHawkHome)\EmuHawk.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ships with BizHawk (loaded already); used to serialize the core's sync-settings object for a
         real cross-peer digest. Bind-only, never copied. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BizHawkHome)\dll\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After build, drop the tool DLL into the install's ExternalTools folder so EmuHawk
       picks it up. Toggle off with -p:DeployToExternalTools=false. -->
  <PropertyGroup>
    <DeployToExternalTools Condition="'$(DeployToExternalTools)' == ''">true</DeployToExternalTools>
  </PropertyGroup>
  <Target Name="DeployToExternalTools" AfterTargets="Build"
          Condition="'$(DeployToExternalTools)' == 'true' and Exists('$(BizHawkHome)\ExternalTools')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BizHawkHome)\ExternalTools" />
    <Copy SourceFiles="$(TargetDir)BizHawkNetplay.Core.dll" DestinationFolder="$(BizHawkHome)\ExternalTools" />
    <Message Importance="high" Text="Deployed $(TargetName) to $(BizHawkHome)\ExternalTools" />
  </Target>

  <!-- Also stage the two shipping DLLs in the repo's dist\ folder (gitignored): one stable path
       to grab artifacts from, whatever the configuration. Last build wins — a Debug build
       overwrites Release DLLs and vice versa, so build -c Release right before attaching these
       to a GitHub release. -->
  <Target Name="DeployToDist" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\dist" />
    <Copy SourceFiles="$(TargetDir)BizHawkNetplay.Core.dll" DestinationFolder="$(MSBuildProjectDirectory)\..\..\dist" />
    <Message Importance="high" Text="Staged $(TargetName) + Core in dist\ ($(Configuration))" />
  </Target>

</Project>
