<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>BizHawkNetplay.Core</RootNamespace>
    <AssemblyName>BizHawkNetplay.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- For MemoryHash.FoldRange only: reading the eight bytes through a fixed pointer instead of
         BitConverter, folded across eight lanes, is about 8x on .NET Framework — which is what the
         tool ships on. That loop walks 8MiB of N64 RDRAM at every checksum, so it is worth the
         keyword. Nothing else in Core is unsafe and nothing else should become so without a
         measurement of its own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Kept in step with the Tool's version. The two DLLs ship together and must be installed
         together, so a pair that disagrees about which release it is would defeat the point of
         stamping either. Bump both when cutting a release. -->
    <Version>0.41.0</Version>
  </PropertyGroup>

</Project>
